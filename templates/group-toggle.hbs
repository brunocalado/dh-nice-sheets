{{!-- Collapse toggle closing a group's plaque, shared by the Features and Inventory tabs. --}}
<a class="nice-legend-button nice-group-toggle" data-action="niceToggleGroup" data-tooltip="DH_NICE_SHEETS.Group.{{ifThen collapsed 'expand' 'collapse'}}">
    <i class="fa-solid {{ifThen collapsed 'fa-chevron-down' 'fa-chevron-up'}}" inert></i>
</a>
