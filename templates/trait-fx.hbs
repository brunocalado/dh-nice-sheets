{{!-- Effects layer of a trait plaque, shared by the sheet header and the settings window. The
     spellcast ring sits outside it, on the border the layer clips away. --}}
{{#if trait.isSpellcasting}}<span class="nice-trait-ring" inert></span>{{/if}}
<span class="nice-trait-fx" inert>
    {{!-- An <i>, not a <span>: the motes are placed by :nth-of-type, and a span in front of them
         would shift one into the corner. --}}
    <i class="nice-trait-tex"></i>
    {{#if trait.isSpellcasting}}
        <svg class="nice-trait-sigil" viewBox="0 0 100 100" aria-hidden="true">
            <g fill="none" stroke="currentColor" stroke-width="1.2">
                <circle cx="50" cy="50" r="46" />
                <circle cx="50" cy="50" r="38" stroke-dasharray="2 4" />
                <polygon points="50,6 60,40 94,50 60,60 50,94 40,60 6,50 40,40" />
                <polygon points="50,20 71,29 80,50 71,71 50,80 29,71 20,50 29,29" />
            </g>
        </svg>
        <span class="nice-trait-mote"></span><span class="nice-trait-mote"></span><span class="nice-trait-mote"></span><span class="nice-trait-mote"></span>
    {{/if}}
    {{#if trait.cracked}}
        <svg class="nice-trait-crack" viewBox="0 0 100 64" preserveAspectRatio="none" aria-hidden="true">
            <g fill="none" stroke-linejoin="bevel">
                <path d="M90 0L86 12L92 22L84 34L89 46L85 64" stroke="rgba(0,0,0,.75)" stroke-width="1.4" />
                <path d="M91 0L87 12L93 22L85 34L90 46L86 64" stroke="rgba(255,255,255,.09)" stroke-width=".8" />
                <path d="M86 12L78 17L76 25" stroke="rgba(0,0,0,.6)" stroke-width="1" />
            </g>
        </svg>
    {{/if}}
    {{#if trait.tierMarked}}<span class="nice-tier-mark"></span>{{/if}}
</span>
