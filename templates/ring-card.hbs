{{!-- A vital as a card: a ring with one segment per slot around a core icon. The ring is open at the
     bottom and the count sits in the opening, which saves the card a line of its own. The icon and
     hue name the resource, so the name lives in the tooltip and the aria-label rather than on the
     card. The sidebar's ring size is set by CSS alone, so collapsing the sheet resizes the cards
     without a re-render. Only an editable card carries the click
     action: left click adds, right click removes (VitalCards#step). --}}
<div class="nice-ring-card {{kind}}" {{#if editable}}data-action="niceStepResource"{{/if}} data-resource="{{resource}}" aria-label="{{label}}"
     data-tooltip-text="{{#if editable}}{{localize "DH_NICE_SHEETS.Resource.step" name=label}}{{else}}{{label}}{{/if}}">
    {{!-- The system's action id carries this spelling. The click handler resolves the closest
         [data-action], so the gear opens the armor tooltip without also stepping the card. --}}
    {{#if (and gear editable card.max)}}
        <a class="nice-ring-gear" data-action="toggleArmorMangement"><i class="fa-solid fa-gear" inert></i></a>
    {{/if}}
    <div class="nice-ring">
        <svg viewBox="0 0 100 100" aria-hidden="true">
            <circle class="well" cx="50" cy="50" r="35" />
            <circle class="rim" cx="50" cy="50" r="48" />
            <circle class="rim" cx="50" cy="50" r="34.5" />
            {{#each card.ring}}<path class="outline" d="{{outline}}" /><path class="seg {{state}}" d="{{d}}" /><path class="streak" d="{{streak}}" />{{/each}}
        </svg>
        <img class="nice-ring-icon" src="{{card.icon}}" alt="" inert />
        <span class="nice-ring-count">{{card.value}}<span class="max"><span class="sep">/</span>{{card.max}}</span></span>
    </div>
</div>
