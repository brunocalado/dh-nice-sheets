<header class="nice-header nice-party-header">
    {{!-- The party art sits behind the whole sheet as a faint backdrop, positioned against
         `.window-content` like the character's. --}}
    {{#if nice.backdrop}}
        <div class="nice-backdrop" style="background-image: url('{{nice.backdrop}}')" inert></div>
    {{/if}}

    <div class="nice-title-row">
        {{!-- `img.profile` is what the system's artwork context menu binds to. --}}
        <img class="profile nice-party-emblem" src="{{source.img}}" data-action="editImage" data-edit="img" alt="" />
        <div class="nice-name-block">
            <h1
                class="actor-name input"
                contenteditable="plaintext-only"
                data-property="name"
                placeholder="{{localize "DAGGERHEART.GENERAL.actorName"}}"
                autocomplete="off"
                spellcheck="false"
            >{{source.name}}</h1>
            <div class="nice-party-meta">
                <span>{{nice.memberCount}}</span>
                {{#if nice.active}}
                    <span class="dot" inert>&#9670;</span>
                    <span class="nice-party-active"><i class="fa-solid fa-flag" inert></i>{{localize "DH_NICE_SHEETS.Party.active"}}</span>
                {{/if}}
            </div>
        </div>

        {{!-- The party actions as coins, cut like the level coin; one lights up while it is under
             way, as Tag Team and Group Roll do. The list comes from the sheet, where the
             `dh-nice-sheets.partyActions` hook lets other modules change it; the GM's coins are
             drawn as the rests. --}}
        <div class="nice-party-actions">
            {{#each nice.partyActions as |entry|}}
                {{#if entry.divider}}<span class="divider" inert></span>{{/if}}
                <a class="nice-party-action {{#if entry.gmOnly}}rest{{/if}} {{#if entry.active}}active{{/if}}"
                   data-action="{{entry.dataAction}}" data-action-id="{{entry.id}}" {{#if entry.type}}data-type="{{entry.type}}"{{/if}}
                   {{#if entry.tooltip}}data-tooltip="{{entry.tooltip}}"{{/if}}>
                    <span class="coin"><i class="{{entry.icon}}" inert></i></span>
                    <span class="caption">{{localize entry.label}}</span>
                </a>
            {{/each}}
        </div>
    </div>

    <nav class="nice-tabs sheet-tabs tabs" data-group="primary">
        {{#each tabs as |tab|}}
            <a class="nice-tab {{tab.cssClass}}" data-action="tab" data-group="{{tab.group}}" data-tab="{{tab.id}}">
                <span>{{localize tab.label}}</span>
            </a>
        {{/each}}
    </nav>
</header>
