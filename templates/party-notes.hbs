<section class="tab {{tabs.notes.cssClass}} {{tabs.notes.id}}" data-tab="{{tabs.notes.id}}" data-group="{{tabs.notes.group}}">
    <div class="nice-scroll nice-sections">
        {{!-- The system's notes field inside a panel of the sheet. The system's own party template
              passes the raw value as `enriched`, which shows GM secret blocks to players and leaves
              @UUID links as text; its context already enriches the notes with the right secrets rule. --}}
        <fieldset class="nice-panel nice-party-notes">
            <legend><span>{{localize tabs.notes.label}}</span></legend>
            {{formInput notes.field value=notes.value enriched=notes.enriched toggled=true}}
        </fieldset>
    </div>
</section>
